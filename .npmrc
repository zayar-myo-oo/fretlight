# npm 10.9.x crashes in peer-dependency resolution ("Cannot read properties of
# null (reading 'edgesOut')") while walking vitest's optional peers
# (@vitest/browser -> webdriverio). Skipping automatic peer installation avoids
# the bug; every direct dependency in this workspace is pinned explicitly, so
# nothing is left to be inferred. Remove this once npm 11+ is the baseline.
legacy-peer-deps=true
